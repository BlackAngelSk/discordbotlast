{
  "name": "discord-bot",
  "version": "2.0.0",
  "description": "A Discord bot built with discord.js. and a variety of features, including music playback, games, and more.",
  "main": "index.js",
  "scripts": {
    "start": "node --no-deprecation index.js",
    "dev": "node --no-deprecation index.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:restart": "pm2 restart discord-bot",
    "pm2:logs": "pm2 logs discord-bot",
    "pm2:save": "pm2 save",
    "slots:sim": "node scripts/simulate-slots-rtp.js",
    "test:slots": "node scripts/test-slots-logic.js",
    "test:steam-dates": "node scripts/test-steam-update-dates.js",
    "test": "node tests/run-all.js",
    "build": "node scripts/verify-build.js",
    "test:jest": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "discord",
    "bot"
  ],
  "author": "BlackAngelSK",
  "license": "ISC",
  "dependencies": {
    "@discordjs/voice": "^0.19.0",
    "@distube/yt-dlp": "^2.0.1",
    "@google/generative-ai": "^0.24.1",
    "@resvg/resvg-js": "^2.6.2",
    "better-sqlite3": "^13.0.1",
    "cloudscraper": "^4.6.0",
    "compression": "^1.8.1",
    "discord.js": "^14.14.1",
    "dotenv": "^16.3.1",
    "ejs": "^4.0.1",
    "express": "^5.2.1",
    "express-session": "^1.18.2",
    "ffmpeg-static": "^5.3.0",
    "libsodium-wrappers": "^0.8.1",
    "opusscript": "^0.0.8",
    "passport": "^0.7.0",
    "passport-discord": "^0.1.4",
    "qrcode": "^1.5.4",
    "sodium-native": "^5.0.10",
    "undici": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.4.2",
    "prettier": "^3.9.4"
  }
}
