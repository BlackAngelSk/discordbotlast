{
  "compilerOptions": {
    "target": "ES2023",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2023"],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "noUncheckedIndexedAccess": false
  },
  "include": [
    "slashCommands/admin/setup.js",
    "utils/season/seasonLeaderboardScheduler.js",
    "utils/steam/steamUpdateUtils.js",
    "dashboard/serverHelpers.js"
  ],
  "exclude": ["node_modules", "data", "logs", "coverage", "backups", ".archive"]
}