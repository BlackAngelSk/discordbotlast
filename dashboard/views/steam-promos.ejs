<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= guild.name %> — Steam Deals &amp; Promos</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" crossorigin="anonymous">
</head>
<body>
<div class="app-layout">
    <%- include('partials/dashboard-sidebar', { guild, currentPath }) %>

    <div class="main-wrapper">
        <%- include('partials/dashboard-topbar', { guild, user, topbarTitle: 'Steam Deals & Promos' }) %>

        <main class="content">
            <% const sourceInfo = typeof sourceHealth === 'undefined' ? {} : (sourceHealth || {}); %>
            <% const dealConf = typeof dealSettings === 'undefined' || !dealSettings ? { salesEnabled: true, promosEnabled: true, freeToKeepEnabled: true, minDiscountPercent: 50, maxDealsPerMessage: 8, dealPostIntervalHours: 3 } : dealSettings; %>
            <% const dealList = typeof deals === 'undefined' ? [] : (deals || []); %>
            <% const dealMatches = typeof dealMatchCount === 'undefined' ? dealList.length : dealMatchCount; %>
            <% const dealSource = typeof dealsSource === 'undefined' ? {} : (dealsSource || {}); %>

            <div class="page-header">
                <h1><i class="fab fa-steam" style="color:#66c0f4;margin-right:8px"></i>Steam Deals &amp; Promo Alerts</h1>
                <p>Posts the games that are <strong>actually on sale right now</strong> — ranked by discount and player reviews — plus any limited-time free-play promos.</p>
                <% if (config?.channelId && dealConf.salesEnabled === false) { %>
                    <p style="margin-top:8px;color:#f4a318;background:rgba(244,163,24,0.12);border:1px solid rgba(244,163,24,0.35);border-radius:8px;padding:8px 10px;display:inline-block;max-width:100%">
                        <i class="fas fa-triangle-exclamation"></i> Sale alerts are currently <strong>off</strong> — only free-play promos will be posted.
                    </p>
                <% } %>
                <% if ((dealSource.totalDiscounted || 0) > 0) { %>
                    <p style="margin-top:8px;color:var(--text-secondary);font-size:0.9rem">
                        <i class="fas fa-store"></i>
                        Steam lists <strong><%= dealSource.totalDiscounted.toLocaleString() %></strong> discounted products in region <strong><%= (dealSource.region || 'sk').toUpperCase() %></strong>; the bot samples the best <%= dealSource.sampledCount || 0 %> for alerts.
                    </p>
                <% } %>
                <% if (Array.isArray(dealSource.sources) && dealSource.sources.length > 0 && !dealSource.sources.includes('steam_search')) { %>
                    <p style="margin-top:8px;color:#f4a318;background:rgba(244,163,24,0.12);border:1px solid rgba(244,163,24,0.35);border-radius:8px;padding:8px 10px;display:inline-block;max-width:100%">
                        <i class="fas fa-triangle-exclamation"></i>
                        Steam's store endpoint is rate-limiting the bot — deals are coming from <strong>CheapShark</strong> (USD prices) until it clears.
                    </p>
                <% } %>
                <% if (dealSource.stale) { %>
                    <p style="margin-top:8px;color:var(--text-secondary);font-size:0.9rem">
                        <i class="fas fa-clock-rotate-left"></i> Showing the last successful deal fetch (all sources unavailable right now).
                    </p>
                <% } %>
            </div>

            <div class="stats-row">
                <div class="stat-card">
                    <div class="stat-card-header"><span class="stat-card-label">Status</span><div class="stat-card-icon <%= config?.channelId ? 'green' : 'yellow' %>"><i class="fas fa-bell"></i></div></div>
                    <div class="stat-card-value"><%= config?.channelId ? 'On' : 'Off' %></div>
                    <div class="stat-card-change"><i class="fas fa-tags"></i> <%= dealConf.salesEnabled === false ? 'Free promos only' : 'Sales + free promos' %></div>
                </div>
                <div class="stat-card">
                    <div class="stat-card-header"><span class="stat-card-label">Alert Channel</span><div class="stat-card-icon blue"><i class="fas fa-hashtag"></i></div></div>
                    <div class="stat-card-value" style="font-size:1rem"><%= config?.channelId ? `#${guild.channels.cache.get(config.channelId)?.name || config.channelId}` : 'Not set' %></div>
                    <div class="stat-card-change"><i class="fas fa-message"></i> Destination channel</div>
                </div>
                <div class="stat-card">
                    <div class="stat-card-header"><span class="stat-card-label">Deals Found</span><div class="stat-card-icon orange"><i class="fas fa-fire"></i></div></div>
                    <div class="stat-card-value"><%= dealMatches %></div>
                    <div class="stat-card-change"><i class="fas fa-percent"></i> Matching filter (<%= dealConf.minDiscountPercent %>%+, <%= dealConf.minReviewCount || 100 %>+ reviews)</div>
                </div>
                <div class="stat-card">
                    <div class="stat-card-header"><span class="stat-card-label">Free to Keep</span><div class="stat-card-icon green"><i class="fas fa-gift"></i></div></div>
                    <div class="stat-card-value"><%= freeGiveaways.length %></div>
                    <div class="stat-card-change"><i class="fas fa-check"></i> Claimable right now</div>
                </div>
                <div class="stat-card">
                    <div class="stat-card-header"><span class="stat-card-label">Free Play</span><div class="stat-card-icon orange"><i class="fas fa-stopwatch"></i></div></div>
                    <div class="stat-card-value"><%= promoGiveaways.length %></div>
                    <div class="stat-card-change"><i class="fas fa-clock"></i> Limited-time promos</div>
                </div>
            </div>

            <div class="card" style="margin-bottom:20px">
                <div class="card-header">
                    <div>
                        <div class="card-title"><i class="fas fa-sliders"></i> Alert Setup</div>
                        <div class="card-subtitle">Pick a channel and how aggressive the deal filter should be. Use the test button to preview a real alert.</div>
                    </div>
                </div>

                <form id="steamPromosForm">
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Discord Channel</label>
                            <select name="channelId" class="form-control" required>
                                <option value="">Select channel</option>
                                <% channels.forEach(channel => { %>
                                    <option value="<%= channel.id %>" <%= config?.channelId === channel.id ? 'selected' : '' %>>#<%= channel.name %></option>
                                <% }) %>
                            </select>
                            <div class="form-hint">Steam deal digests and free-weekend alerts are posted here.</div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Minimum discount</label>
                            <select name="minDiscountPercent" class="form-control">
                                <% [30, 40, 50, 60, 70, 80].forEach(percent => { %>
                                    <option value="<%= percent %>" <%= Number(dealConf.minDiscountPercent) === percent ? 'selected' : '' %>><%= percent %>% off or more</option>
                                <% }) %>
                            </select>
                            <div class="form-hint">Lower = more deals, higher = only deep cuts.</div>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Deals per message</label>
                            <select name="maxDealsPerMessage" class="form-control">
                                <% [4, 6, 8, 10].forEach(count => { %>
                                    <option value="<%= count %>" <%= Number(dealConf.maxDealsPerMessage) === count ? 'selected' : '' %>><%= count %> games</option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Digest interval</label>
                            <select name="dealPostIntervalHours" class="form-control">
                                <% [1, 2, 3, 6, 12, 24].forEach(hours => { %>
                                    <option value="<%= hours %>" <%= Number(dealConf.dealPostIntervalHours) === hours ? 'selected' : '' %>>Every <%= hours %>h at most</option>
                                <% }) %>
                            </select>
                            <div class="form-hint">Throttle so a Steam sale doesn't flood the channel.</div>
                        </div>
                    </div>

                    <div class="toggle-group">
                        <div class="toggle-info">
                            <h4>Steam sale alerts</h4>
                            <p>Post games that are on sale right now (discount + price + review score).</p>
                        </div>
                        <label class="toggle-switch">
                            <input type="checkbox" name="salesEnabled" <%= dealConf.salesEnabled === false ? '' : 'checked' %>>
                            <span class="toggle-slider"></span>
                        </label>
                    </div>

                    <div class="toggle-group">
                        <div class="toggle-info">
                            <h4>Free-play promos</h4>
                            <p>Also post free weekends / temporary play-for-free events (rare).</p>
                        </div>
                        <label class="toggle-switch">
                            <input type="checkbox" name="promosEnabled" <%= dealConf.promosEnabled === false ? '' : 'checked' %>>
                            <span class="toggle-slider"></span>
                        </label>
                    </div>

                    <div class="toggle-group">
                        <div class="toggle-info">
                            <h4>Free-to-keep alerts</h4>
                            <p>Post a message here whenever a Steam game goes permanently free (claim it and it stays yours).</p>
                        </div>
                        <label class="toggle-switch">
                            <input type="checkbox" name="freeToKeepEnabled" <%= dealConf.freeToKeepEnabled === false ? '' : 'checked' %>>
                            <span class="toggle-slider"></span>
                        </label>
                    </div>

                    <div class="form-actions" style="justify-content:flex-start">
                        <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Save Settings</button>
                        <button type="button" class="btn btn-secondary" id="refreshSteamPromosBtn"><i class="fas fa-rotate"></i> Force Check Now</button>
                        <button type="button" class="btn btn-secondary" id="testSteamPromosBtn"><i class="fas fa-flask"></i> Send Test Alert</button>
                        <button type="button" class="btn btn-danger" id="clearSteamPromosBtn"><i class="fas fa-trash"></i> Disable Alerts</button>
                    </div>
                </form>
            </div>

            <%# Section 1: games on sale right now %>
            <div class="card" style="margin-bottom:20px">
                <div class="card-header">
                    <div>
                        <div class="card-title"><i class="fas fa-fire" style="color:#66c0f4"></i> On Sale Right Now</div>
                        <div class="card-subtitle">Best current discounts that pass this server's filter — this is what the bot posts.</div>
                    </div>
                </div>

                <% if (dealList.length > 0) { %>
                    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px">
                        <% dealList.forEach(deal => { %>
                            <article class="card" style="margin:0;background:var(--bg-card-2);border-left:3px solid #66c0f4">
                                <% if (deal.imageUrl) { %>
                                    <img src="<%= deal.imageUrl %>" alt="<%= deal.title %>" loading="lazy" style="width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:12px;margin-bottom:12px">
                                <% } %>
                                <div class="card-title" style="margin-bottom:8px">
                                    <span style="background:#66c0f4;color:#0b1a24;border-radius:6px;padding:1px 7px;font-size:0.8rem;margin-right:6px">-<%= deal.discountPercent %>%</span>
                                    <%= deal.title %>
                                </div>
                                <div class="form-hint" style="margin-bottom:10px">
                                    <% if (deal.priceOriginal) { %>
                                        <span style="text-decoration:line-through;opacity:0.7"><%= deal.priceOriginal %></span>
                                    <% } %>
                                    <% if (deal.priceFinal) { %>
                                        &nbsp;→&nbsp;<strong style="color:#66c0f4"><%= deal.priceFinal %></strong>
                                    <% } %>
                                    <% if (deal.reviewPercent) { %>
                                        &nbsp;·&nbsp;<i class="fas fa-thumbs-up"></i> <%= deal.reviewPercent %>%
                                        <% if (deal.reviewCount) { %>(<%= deal.reviewCount.toLocaleString() %>)<% } %>
                                    <% } %>
                                    <% if (deal.endsAt) { %>
                                        &nbsp;·&nbsp;<i class="fas fa-stopwatch"></i> ends <%= new Date(deal.endsAt).toLocaleString() %>
                                    <% } %>
                                </div>
                                <a href="<%= deal.url %>" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm"><i class="fas fa-up-right-from-square"></i> View on Steam</a>
                            </article>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="table-empty"><i class="fas fa-fire"></i> No deals match the current filter. Lower the minimum discount or press Force Check Now.</div>
                <% } %>
            </div>

            <%# Section 2: free to keep giveaways %>
            <div class="card" style="margin-bottom:20px">
                <div class="card-header">
                    <div>
                        <div class="card-title"><i class="fas fa-gift" style="color:#57f287"></i> Free to Keep</div>
                        <div class="card-subtitle">Steam Store games that are permanently free right now — claim before the offer ends and they stay in your library. Third-party key giveaways are ignored.</div>
                    </div>
                </div>

                <% if (freeGiveaways.length > 0) { %>
                    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px">
                        <% freeGiveaways.forEach(giveaway => { %>
                            <article class="card" style="margin:0;background:var(--bg-card-2);border-left:3px solid #57f287">
                                <% if (giveaway.imageUrl) { %>
                                    <img src="<%= giveaway.imageUrl %>" alt="<%= giveaway.title %>" loading="lazy" style="width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:12px;margin-bottom:12px">
                                <% } %>
                                <div class="card-title" style="margin-bottom:8px"><%= giveaway.title %></div>
                                <div class="form-hint" style="margin-bottom:10px">
                                    <% if (giveaway.worth && !/^n\/a$/i.test(giveaway.worth)) { %>
                                        <span style="color:#57f287"><i class="fas fa-tag"></i> <%= giveaway.worth %></span>
                                    <% } else { %>
                                        <span style="color:#57f287"><i class="fas fa-tag"></i> Free forever</span>
                                    <% } %>
                                    <% if (giveaway.endDate) { %>
                                        &nbsp;·&nbsp;<i class="fas fa-stopwatch"></i> Ends <%= new Date(giveaway.endDate).toLocaleString() %>
                                    <% } %>
                                </div>
                                <% if (giveaway.description) { %>
                                    <p style="margin:0 0 12px;color:var(--text-secondary);font-size:0.88rem"><%= giveaway.description %></p>
                                <% } %>
                                <a href="<%= giveaway.url %>" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm"><i class="fas fa-up-right-from-square"></i> Claim on Steam</a>
                            </article>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="table-empty"><i class="fas fa-gift"></i> No free-to-keep giveaways are active right now — the bot will post here when one shows up.</div>
                <% } %>
            </div>

            <%# Section 3: Steam free weekend / promo play events %>
            <div class="card" style="margin-bottom:20px">
                <div class="card-header">
                    <div>
                        <div class="card-title"><i class="fas fa-stopwatch" style="color:#f4a318"></i> Free Weekends &amp; Play Events</div>
                        <div class="card-subtitle">Games currently free to play on Steam — <strong>will be removed from your library after the promo ends</strong>.</div>
                    </div>
                </div>

                <% if (promoGiveaways.length > 0) { %>
                    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px">
                        <% promoGiveaways.forEach(giveaway => { %>
                            <article class="card" style="margin:0;background:var(--bg-card-2);border-left:3px solid #f4a318">
                                <% if (giveaway.imageUrl) { %>
                                    <img src="<%= giveaway.imageUrl %>" alt="<%= giveaway.title %>" style="width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:12px;margin-bottom:12px">
                                <% } %>
                                <div class="card-title" style="margin-bottom:8px"><%= giveaway.title %></div>
                                <div class="form-hint" style="margin-bottom:10px">
                                    <% if (giveaway.worth && !/^n\/a$/i.test(giveaway.worth)) { %>
                                        <span style="color:#f4a318"><i class="fas fa-tag"></i> <%= giveaway.worth %></span>
                                    <% } %>
                                    <% if (giveaway.endDate) { %>
                                        &nbsp;·&nbsp;<i class="fas fa-stopwatch"></i> Ends <%= new Date(giveaway.endDate).toLocaleString() %>
                                    <% } else { %>
                                        &nbsp;·&nbsp;<i class="fas fa-stopwatch"></i> Limited time
                                    <% } %>
                                </div>
                                <% if (giveaway.description) { %>
                                    <p style="margin:0 0 12px;color:var(--text-secondary);font-size:0.88rem"><%= giveaway.description %></p>
                                <% } %>
                                <a href="<%= giveaway.url %>" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm"><i class="fas fa-up-right-from-square"></i> View on Steam</a>
                            </article>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="table-empty"><i class="fas fa-stopwatch"></i> No Steam free weekends or play events are active right now.</div>
                <% } %>
            </div>

        </main>
    </div>
</div>

<%- include('partials/dashboard-common-scripts') %>
<script>
const guildId = '<%= guild.id %>';
const form = document.getElementById('steamPromosForm');
const channelSelect = form.querySelector('select[name="channelId"]');
const saveButton = form.querySelector('button[type="submit"]');
const refreshButton = document.getElementById('refreshSteamPromosBtn');
const testButton = document.getElementById('testSteamPromosBtn');
const clearButton = document.getElementById('clearSteamPromosBtn');

refreshButton.addEventListener('click', async () => {
    const original = refreshButton.innerHTML;
    refreshButton.disabled = true;
    refreshButton.innerHTML = '<span class="spinner"></span> Refreshing...';

    try {
        const response = await fetch(`/api/steam-promos/${guildId}/refresh`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });

        const result = await response.json();
        if (!response.ok || !result.success) {
            throw new Error(result.error || 'Failed to force check Steam deals');
        }

        dashboardUI.showToast(result.message || 'Steam force check completed.', 'success');
        setTimeout(() => location.reload(), 700);
    } catch (error) {
        dashboardUI.showToast(error.message || 'Failed to force check Steam deals.', 'error');
    } finally {
        refreshButton.disabled = false;
        refreshButton.innerHTML = original;
    }
});

form.addEventListener('submit', async (event) => {
    event.preventDefault();
    const original = saveButton.innerHTML;
    saveButton.disabled = true;
    saveButton.innerHTML = '<span class="spinner"></span> Saving...';

    try {
        const payload = {
            channelId: channelSelect.value,
            salesEnabled: form.querySelector('input[name="salesEnabled"]').checked,
            promosEnabled: form.querySelector('input[name="promosEnabled"]').checked,
            freeToKeepEnabled: form.querySelector('input[name="freeToKeepEnabled"]').checked,
            minDiscountPercent: Number(form.querySelector('select[name="minDiscountPercent"]').value),
            maxDealsPerMessage: Number(form.querySelector('select[name="maxDealsPerMessage"]').value),
            dealPostIntervalHours: Number(form.querySelector('select[name="dealPostIntervalHours"]').value)
        };

        const response = await fetch(`/api/steam-promos/${guildId}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });
        const result = await response.json();
        if (!response.ok || !result.success) {
            throw new Error(result.error || 'Failed to save Steam alert settings');
        }
        dashboardUI.showToast('Steam alert settings saved.', 'success');
        setTimeout(() => location.reload(), 600);
    } catch (error) {
        dashboardUI.showToast(error.message || 'Failed to save Steam alert settings.', 'error');
    } finally {
        saveButton.disabled = false;
        saveButton.innerHTML = original;
    }
});

testButton.addEventListener('click', async () => {
    const original = testButton.innerHTML;
    testButton.disabled = true;
    testButton.innerHTML = '<span class="spinner"></span> Sending...';

    try {
        const response = await fetch(`/api/steam-promos/${guildId}/test`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ channelId: channelSelect.value || null })
        });
        const result = await response.json();
        if (!response.ok || !result.success) {
            throw new Error(result.error || 'Failed to send Steam test alert');
        }
        dashboardUI.showToast(result.message || 'Steam test alert sent.', 'success');
    } catch (error) {
        dashboardUI.showToast(error.message || 'Failed to send Steam test alert.', 'error');
    } finally {
        testButton.disabled = false;
        testButton.innerHTML = original;
    }
});

clearButton.addEventListener('click', async () => {
    if (!confirm('Disable Steam deal and promo alerts for this server?')) {
        return;
    }

    const original = clearButton.innerHTML;
    clearButton.disabled = true;
    clearButton.innerHTML = '<span class="spinner"></span> Removing...';

    try {
        const response = await fetch(`/api/steam-promos/${guildId}`, {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' }
        });
        const result = await response.json();
        if (!response.ok || !result.success) {
            throw new Error(result.error || 'Failed to disable Steam alerts');
        }
        dashboardUI.showToast('Steam deal and promo alerts disabled.', 'success');
        setTimeout(() => location.reload(), 500);
    } catch (error) {
        dashboardUI.showToast(error.message || 'Failed to disable Steam alerts.', 'error');
    } finally {
        clearButton.disabled = false;
        clearButton.innerHTML = original;
    }
});
</script>
</body>
</html>
